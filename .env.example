NEXT_PUBLIC_CREATOR_PROFILE_ENABLED=false
# Product reviews (stars, PDP section, JSON-LD, account and email review pages).
# "true" to enable; anything else ships dark.
NEXT_PUBLIC_REVIEWS_ENABLED=false

# --- AI review summaries (M7). Server-only: never prefix these with NEXT_PUBLIC_. ---
# Anthropic API key used by /api/internal/reviews/summarize (Claude, claude-opus-5-5).
ANTHROPIC_API_KEY=
# Shared secret the admin sends as `Authorization: Bearer <secret>` when it calls
# POST /api/internal/reviews/summarize (rake reviews:dispatch / Regenerate). Same value as the admin's INTERNAL_CRON_SECRET.
INTERNAL_CRON_SECRET=
# API key of an admin service user (Users › API key in the admin). Sent as X-Spree-Token
# (no Authorization header) to the admin's /api/v1/admin/review_summaries endpoints.
# The route calls the admin server-to-server at SPREE_API_URL (falls back to NEXT_PUBLIC_SPREE_API_URL).
DNA_ADMIN_SERVICE_TOKEN=

# Sentry (project: material-instinct-llc/beeper-frontend)
# Leave NEXT_PUBLIC_SENTRY_DSN empty to disable reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time only, for source map upload. Needs project:releases scope.
SENTRY_AUTH_TOKEN=
# App store links for the "get the Beeper app" callouts. The admin's app link
# settings override these. Android is omitted from the site when both are empty.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
